// Generates supabase/sample_content.sql from the sample library.
// Run: npm run sample:sql   (requires Node 22.6+ for --experimental-strip-types)
import { writeFileSync } from "node:fs";
import { countries, cuisines, ingredients, recipes } from "../src/lib/demo/library.ts";

const q = (v: string | number | null | undefined) =>
  v === null || v === undefined ? "null" : typeof v === "number" ? String(v) : `'${String(v).replace(/'/g, "''")}'`;
const rid = (slug: string) => `md5('mond-sample-${slug}')::uuid`;
const out: string[] = [
  "-- SAMPLE CONTENT for a staging/review database. Generated by scripts/generate-sample-sql.mts — do not edit by hand.",
  "-- Every recipe is marked is_sample = true. Remove it all with:",
  "--   delete from public.recipes where is_sample;",
  "-- Run AFTER the migrations and seed.sql, as the database owner (SQL Editor).",
  "begin;",
  "",
];

out.push("insert into public.cuisines (slug, name) values");
out.push(cuisines.map((c) => `  (${q(c.slug)}, ${q(c.name)})`).join(",\n") + "\non conflict (slug) do nothing;\n");

for (const c of countries) {
  out.push(
    `update public.countries set intro = coalesce(intro, ${q(c.intro)}), food_culture = coalesce(food_culture, ${q(c.foodCulture ?? null)}), is_featured = ${c.isFeatured ? "true" : "is_featured"} where slug = ${q(c.slug)};`,
  );
  for (const a of c.aliases ?? [])
    out.push(`insert into public.country_aliases (country_id, alias) select id, ${q(a)} from public.countries where slug = ${q(c.slug)} on conflict do nothing;`);
  (c.regions ?? []).forEach((g, i) =>
    out.push(
      `insert into public.regions (country_id, slug, name, description, display_order) select id, ${q(g.slug)}, ${q(g.name)}, ${q(g.description)}, ${i} from public.countries where slug = ${q(c.slug)} on conflict (country_id, slug) do nothing;`,
    ),
  );
}
out.push("");

out.push("insert into public.ingredients (slug, name, grams_per_cup) values");
out.push(ingredients.map((i) => `  (${q(i.slug)}, ${q(i.name)}, ${q(i.gramsPerCup ?? null)})`).join(",\n") + "\non conflict (slug) do nothing;\n");
for (const i of ingredients)
  for (const a of i.aliases ?? [])
    out.push(`insert into public.ingredient_aliases (ingredient_id, alias) select id, ${q(a)} from public.ingredients where slug = ${q(i.slug)} on conflict do nothing;`);
out.push("");

for (const r of recipes) {
  out.push(`-- ${r.title}`);
  out.push(
    `insert into public.recipes (id, kind, slug, title, summary, status, verification, prep_minutes, cook_minutes, servings, serving_unit, difficulty, tips, substitutions, drink_category_id, is_sample)
values (${rid(r.slug)}, ${q(r.kind)}, ${q(r.slug)}, ${q(r.title)}, ${q(r.summary)}, 'published', 'community', ${r.prep}, ${r.cook}, ${r.servings}, ${q(r.servingUnit ?? null)}, ${q(r.difficulty)}, ${q(r.tips ?? null)}, ${q(r.substitutions ?? null)}, ${r.drinkCategory ? `(select id from public.drink_categories where slug = ${q(r.drinkCategory)})` : "null"}, true)
on conflict (slug) do nothing;`,
  );
  r.ingredients.forEach(([qty, unit, slug, note, group], i) =>
    out.push(
      `insert into public.recipe_ingredients (recipe_id, ingredient_id, position, quantity, unit, note, group_label) select ${rid(r.slug)}, id, ${i + 1}, ${q(qty)}, ${q(unit)}, ${q(note ?? null)}, ${q(group ?? null)} from public.ingredients where slug = ${q(slug)} on conflict do nothing;`,
    ),
  );
  r.steps.forEach(([body, timer], i) =>
    out.push(`insert into public.recipe_steps (recipe_id, position, body, timer_seconds) values (${rid(r.slug)}, ${i + 1}, ${q(body)}, ${q(timer ?? null)}) on conflict do nothing;`),
  );
  const link = (table: string, col: string, ref: string, slugs: string[] | undefined) =>
    (slugs ?? []).forEach((s) =>
      out.push(`insert into public.${table} (recipe_id, ${col}) select ${rid(r.slug)}, id from public.${ref} where slug = ${q(s)} on conflict do nothing;`),
    );
  link("recipe_countries", "country_id", "countries", r.countries);
  link("recipe_cuisines", "cuisine_id", "cuisines", r.cuisines);
  link("recipe_categories", "category_id", "categories", r.categories);
  link("recipe_dietary_tags", "dietary_tag_id", "dietary_tags", r.diets);
  link("recipe_allergens", "allergen_id", "allergens", r.allergens);
  (r.regions ?? []).forEach((s) =>
    out.push(
      `insert into public.recipe_regions (recipe_id, region_id) select ${rid(r.slug)}, g.id from public.regions g join public.recipe_countries rc on rc.country_id = g.country_id and rc.recipe_id = ${rid(r.slug)} where g.slug = ${q(s)} on conflict do nothing;`,
    ),
  );
  out.push(`insert into public.recipe_sources (recipe_id, source_type, description) select ${rid(r.slug)}, 'original', 'Sample recipe for design review' where not exists (select 1 from public.recipe_sources where recipe_id = ${rid(r.slug)});`);
  out.push("");
}

out.push("commit;");
writeFileSync(new URL("../supabase/sample_content.sql", import.meta.url), out.join("\n") + "\n");
console.log(`Wrote supabase/sample_content.sql (${recipes.length} sample recipes)`);
