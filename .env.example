# Copy to .env.local for local development. On Hostinger, add these in
# hPanel → your Node.js web app → Environment variables BEFORE building
# (NEXT_PUBLIC_ values are built into the site).

# Public site address, no trailing slash. Used for links in emails, sitemap and social sharing.
NEXT_PUBLIC_SITE_URL=https://www.mondrecipes.com

# Supabase → Project Settings → API. Both are safe to expose: Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Supabase secret (service_role) key. SERVER ONLY: never give it a NEXT_PUBLIC_ name.
# Used for the newsletter double opt-in, rate limiting and the link checker.
SUPABASE_SERVICE_ROLE_KEY=

# Email via Resend (https://resend.com). Verify your domain there first.
# Without these, the newsletter and contact form say they aren't switched on yet.
RESEND_API_KEY=
EMAIL_FROM="Mònd Recipes <hello@mondrecipes.com>"
# Where contact-form messages are delivered (your own inbox).
CONTACT_EMAIL=

# Long random string. The Hostinger cron job sends it to /api/cron/check-links.
CRON_SECRET=

# Optional. Leave empty until each service is set up and approved.
# Ads and analytics load only after the visitor accepts them in the cookie banner.
NEXT_PUBLIC_ADSENSE_CLIENT=

# Cloudflare Turnstile site key (spam check on sign-up, sign-in and password reset).
# Turn on CAPTCHA protection in Supabase with the matching secret key at the same time.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_GA_ID=
